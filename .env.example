# =============================================================
# Social Media Automation — Variables de entorno
# =============================================================
# Copia este fichero como .env y rellena tus claves.
# NUNCA subas .env a git (ya está en .gitignore).
#
# ┌─────────────────────────────────────────────────────────┐
# │  ELIGE UN PROVEEDOR LLM: descomenta el bloque que uses  │
# └─────────────────────────────────────────────────────────┘

# -------------------------------------------------------------
# OPCIÓN A — LM Studio (local, sin coste)
# LM Studio expone una API compatible con OpenAI en localhost.
# Asegúrate de que LM Studio está corriendo antes de lanzar los agentes.
# -------------------------------------------------------------
OPENAI_BASE_URL=http://127.0.0.1:1234/v1
OPENAI_API_KEY=lm-studio          # LM Studio no valida la key; este valor es un placeholder
OPENAI_MODEL=qwen/qwen3.5-9b        # Modelo detectado en LM Studio
                                  # Ejemplo: mistral-7b-instruct, llama-3-8b-instruct, etc.

# -------------------------------------------------------------
# OPCIÓN B — Anthropic Claude (cloud)
# Comenta el bloque anterior y descomenta este para usar Claude.
# -------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...

# -------------------------------------------------------------
# NOTION — Necesario para que los agentes lean/escriban tareas
# -------------------------------------------------------------
# Tu Integration Token (empieza con secret_)
NOTION_API_KEY=ntn_l80308449466NZjt4mtuqRf3AHBGD16TYioLHfReTGD1C2

# ID de la base de datos "Social Media Content Board"
# Se obtiene de la URL de Notion: notion.so/xxxxx?v=yyyyy -> xxxxx
NOTION_DATABASE_ID=32b1deacf81280baa920f82a512affb1

# -------------------------------------------------------------
# BÚSQUEDA WEB — Para el Trends Agent
# Usa el motor de búsqueda que hayas configurado en OpenClaw.
# Si usas Brave Search:
# -------------------------------------------------------------
BRAVE_SEARCH_API_KEY=BSA...

# -------------------------------------------------------------
# OPCIONAL — OpenAI (si prefieres GPT en lugar de LM Studio)
# -------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
